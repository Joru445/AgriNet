# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# Backend API URL (required for production builds/deploys)
# Include the /api prefix, e.g. https://agrinet-backend-c8w7.onrender.com/api
# Local dev uses the same-origin /api Vite proxy instead; this value still
# configures the proxy target (and is the API base used by production builds).
VITE_API_URL=

# Cloudinary Configuration
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_PRODUCT_PRESET=
VITE_CLOUDINARY_PROFILE_PRESET=
VITE_CLOUDINARY_MESSAGE_PRESET=
VITE_CLOUDINARY_TRANSACTION_PRESET=
