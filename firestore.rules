rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * ============================================================
     * HELPERS
     * ============================================================
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    /*
     * Only users with status == "active" can perform
     * normal application actions.
     */
    function hasLinkedPhone() {
      return isSignedIn() && request.auth.token.get("phone_number", null) is string;
    }

    function isActive() {
      return isSignedIn()
        && currentUser().data.status == "active"
        && hasLinkedPhone();
    }

    /*
     * Admin bypasses the active-status restriction.
     * This allows admins to manage suspended accounts.
     */
    function isAdmin() {
      return isSignedIn()
        && currentUser().data.role == "admin";
    }

    function isOwner(userId) {
      return isActive()
        && request.auth.uid == userId;
    }

    function isFarmer() {
      return isActive()
        && currentUser().data.role == "farmer";
    }

    function isConsumer() {
      return isActive()
        && currentUser().data.role == "consumer";
    }

    function isParticipant(conversationId) {
      return isSignedIn()
        && request.auth.uid in
          get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participants;
    }

    function isConversationParticipant(data) {
      return isSignedIn()
        && request.auth.uid in data.participants;
    }


    /*
     * ============================================================
     * USER PROFILE UPDATE
     *
     * Users can update their own profile but cannot change:
     *
     * uid
     * email
     * role
     * status
     * ============================================================
     */

    function isUserProfileUpdate(userId) {
  		return isOwner(userId)

    		&& !request.resource.data
      		.diff(resource.data)
      		.affectedKeys()
      		.hasAny([
        		"uid",
        		"email",
                "phone",
        		"role",
        		"status",

        		// Moderation/trust fields are backend-only
        		"verified",
        		"verificationStatus",
        		"rating",
        		"reviewCount",
        		"createdAt"
      		]);
		}


    /*
     * ============================================================
     * ADMIN USER UPDATE
     *
     * Admin can modify fields such as:
     *
     * status
     *
     * But cannot change the user's identity fields.
     * ============================================================
     */

    function isAdminUserUpdate() {
  		return isAdmin()
    		&& request.resource.data
      		.diff(resource.data)
      		.affectedKeys()
      		.hasOnly(["status"]);
		}


    /*
     * ============================================================
     * USERS
     * ============================================================
     */

    match /users/{userId} {

      // These documents contain private email/phone/address and MUST NOT be public.
      // Public profiles are served by the redacting /api/v1/users/:uid API.
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();


      /*
       * Registration.
       *
       * We cannot use isActive() here because the user's
       * Firestore document does not exist yet.
       */
      allow create: if
        isSignedIn()
        && request.auth.uid == userId

        // Registration only: clients may only create consumer/farmer accounts
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ["consumer", "farmer"]
        && request.resource.data.status == "active"

        // Moderation/trust fields are backend-only
        && !request.resource.data.keys()
          .hasAny(["verified", "verificationStatus", "rating", "reviewCount"]);


      /*
       * User updates their own allowed profile fields.
       *
       * Admin updates account status.
       */
      allow update: if
        isUserProfileUpdate(userId)
        || isAdminUserUpdate();


      allow delete: if isAdmin();

      match /installations/{installationId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      /*
       * Passkeys (WebAuthn credentials).
       *
       * Backend-managed via Admin SDK. Clients cannot directly
       * create, modify, or delete passkey documents.
       */
      match /passkeys/{credentialId} {
        allow read, write: if false;
      }
    }

    // Device-session records are security-sensitive and backend-only. Firebase
    // rules cannot bind a standard Firebase ID token to one browser session.
    match /userSessions/{userId}/sessions/{sessionId} {
      allow read, write: if false;
    }

    match /userSecurityEvents/{userId}/events/{eventId} {
      allow read, write: if false;
    }


    /*
     * ============================================================
     * FARMERS
     * ============================================================
     */

    match /farmers/{farmerId} {

      // Public farmer information is served by /api/v1/farmers/:uid.
      allow read: if (isSignedIn() && request.auth.uid == farmerId) || isAdmin();


      /*
       * New farmer profile creation.
       *
       * Clients may only create a "not_applied" profile; verification,
       * rating and reviewCount are backend-exclusive.
       */
      allow create: if
        isSignedIn()
        && request.auth.uid == farmerId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.verified == false
        && (
          !request.resource.data.keys()
            .hasAny(["verificationStatus"])
          ||
          request.resource.data.verificationStatus == "not_applied"
        )
        && (
          !request.resource.data.keys()
            .hasAny(["rating"])
          ||
          request.resource.data.rating == 0
        )
        && (
          !request.resource.data.keys()
            .hasAny(["reviewCount"])
          ||
          request.resource.data.reviewCount == 0
        );


      /*
       * Owners may maintain their public profile but cannot touch
       * trust/moderation fields.
       */
      allow update, delete: if
        (
          isOwner(farmerId)
          && !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny([
              "uid",
              "email",
              "phone",
              "role",
              "verified",
              "verificationStatus",
              "rating",
              "reviewCount",
              "createdAt"
            ])
        )
        || isAdmin();
    }


    /*
     * ============================================================
     * PRODUCTS
     * ============================================================
     */

    match /products/{productId} {
      allow read: if true;
      // Products are backend-controlled so users cannot alter stock, ratings,
      // archives or the seller ID through the Firebase SDK.
      // Unverified farmers CAN sell through the authenticated API.
      allow create, update, delete: if false;
    }


    /*
     * ============================================================
     * FARMER REVIEWS
     *
     * Document ID:
     *
     * reviews/{inquiryId}
     *
     * One farmer review per completed transaction.
     * ============================================================
     */

    match /reviews/{reviewId} {

      allow read: if true;


      /*
       * Only active consumers can create reviews.
       */
      allow create: if

        isConsumer()

        && reviewId
           == request.resource.data.inquiryId

        && request.resource.data.reviewerId
           == request.auth.uid

        && exists(
          /databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId)
        )

        && get(
          /databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId)
        ).data.status
           == "completed"

        && get(
          /databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId)
        ).data.consumerId
           == request.auth.uid

        && request.resource.data.farmerId
           == get(
             /databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId)
           ).data.farmerId

        && request.resource.data.inquiryId
           is string

        && request.resource.data.farmerId
           is string

        && request.resource.data.reviewerId
           is string

        && request.resource.data.rating
           is number

        && request.resource.data.rating >= 1

        && request.resource.data.rating <= 5

        && request.resource.data.comment
           is string;


      allow update: if

        isActive()

        && resource.data.reviewerId
           == request.auth.uid

        && request.resource.data.inquiryId
           == resource.data.inquiryId

        && request.resource.data.farmerId
           == resource.data.farmerId

        && request.resource.data.reviewerId
           == resource.data.reviewerId

        && request.resource.data.rating
           is number

        && request.resource.data.rating >= 1

        && request.resource.data.rating <= 5

        && request.resource.data.comment
           is string;


      allow delete: if
        (
          isActive()

          && resource.data.reviewerId
             == request.auth.uid
        )
        || isAdmin();
    }


    /*
     * ============================================================
     * PRODUCT REVIEWS
     *
     * Document ID:
     *
     * product-reviews/{inquiryId}
     * ============================================================
     */

    match /product-reviews/{reviewId} {

      allow read: if true;


      allow create: if

        isConsumer()

        && reviewId
           == request.resource.data.inquiryId

        && request.resource.data.reviewerId
           == request.auth.uid

        && exists(
          /databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId)
        )

        && get(
          /databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId)
        ).data.status
           == "completed"

        && get(
          /databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId)
        ).data.consumerId
           == request.auth.uid

        && request.resource.data.productId
           == get(
             /databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId)
           ).data.productId

        && request.resource.data.inquiryId
           is string

        && request.resource.data.productId
           is string

        && request.resource.data.reviewerId
           is string

        && request.resource.data.rating
           is number

        && request.resource.data.rating >= 1

        && request.resource.data.rating <= 5

        && request.resource.data.comment
           is string;


      allow update: if

        isActive()

        && resource.data.reviewerId
           == request.auth.uid

        && request.resource.data.inquiryId
           == resource.data.inquiryId

        && request.resource.data.productId
           == resource.data.productId

        && request.resource.data.reviewerId
           == resource.data.reviewerId

        && request.resource.data.rating
           is number

        && request.resource.data.rating >= 1

        && request.resource.data.rating <= 5

        && request.resource.data.comment
           is string;


      allow delete: if
        (
          isActive()

          && resource.data.reviewerId
             == request.auth.uid
        )
        || isAdmin();
    }


    /*
     * ============================================================
     * CONVERSATIONS
     * ============================================================
     */

    match /conversations/{conversationId} {
      allow read: if isAdmin() || isConversationParticipant(resource.data);
      // The API verifies both participants and creates canonical conversations.
      allow create: if false;
      // Only one's own read receipt and live-location end flags are client-editable.
      // Unread counts and latest-message metadata are backend-managed.
      allow update: if isActive()
        && isConversationParticipant(resource.data)
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["lastRead", "endedLocations", "lastEndedLocationAt"]);
      allow delete: if false;
    }


    /*
     * ============================================================
     * MESSAGES
     * ============================================================
     */

    match /messages/{messageId} {

      // Backend must validate all message creation, including live locations.
      allow create: if false;

      // Backend owns accepted inquiry transitions and all message metadata.
      // Location updates are the only allowed client-side edits.
      allow update: if isActive()
        && resource.data.senderId == request.auth.uid
        && (resource.data.type in ["text", "location", "live_location"])
        && (resource.data.keys().hasAny(["location", "locationType"]))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["location", "isLive", "isEnded", "endedAt", "liveUntil", "locationEndedAt"])
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.conversationId == resource.data.conversationId;

      allow delete: if false;

      allow read: if
        isAdmin()
        || isParticipant(
          resource.data.conversationId
        );
    }


    /*
     * ============================================================
     * INQUIRIES
     *
     * Lifecycle:
     *
     * accepted
     *    ↓
     * ongoing
     *    ↓
     * awaiting_proof
     *    ↓
     * proof_submitted
     *    ↓
     * completed
     *
     * proof_submitted
     *    ↓
     * awaiting_proof
     *
     * accepted / ongoing
     *    ↓
     * cancelled
     *
     * completed
     *    ↓
     * reviewed = true
     * ============================================================
     */

    match /inquiries/{inquiryId} {

      allow read: if

        isAdmin()

        ||

        (
          isSignedIn()

          && resource.data.consumerId
             == request.auth.uid
        )

        ||

        (
          isSignedIn()

          && resource.data.farmerId
             == request.auth.uid
        );


      /*
       * Farmer creates inquiry after accepting
       * the product inquiry message.
       */
      allow create: if

        isFarmer()

        && request.resource.data.farmerId
           == request.auth.uid

        && request.resource.data.consumerId
           != request.auth.uid

        && request.resource.data.consumerId
           is string

        && request.resource.data.farmerId
           is string

        && request.resource.data.conversationId
           is string

        && request.resource.data.productId
           is string

        && request.resource.data.inquiryMessageId
           is string

        && request.resource.data.status
           == "accepted"

        && request.resource.data.quantity
           is number

        && request.resource.data.quantity > 0

        // Type field: must be "standard" or "preorder"
        && (
          !request.resource.data.keys()
            .hasAny(["type"])

          ||

          request.resource.data.type
             == "standard"

          ||

          request.resource.data.type
             == "preorder"
        )

        && isParticipant(
          request.resource.data.conversationId
        )

        && exists(
          /databases/$(database)/documents/messages/$(request.resource.data.inquiryMessageId)
        )

        && get(
          /databases/$(database)/documents/messages/$(request.resource.data.inquiryMessageId)
        ).data.type
           == "product_inquiry"

        && get(
          /databases/$(database)/documents/messages/$(request.resource.data.inquiryMessageId)
        ).data.inquiryStatus
           == "pending"

        && request.resource.data.quantity
           ==
           get(
             /databases/$(database)/documents/messages/$(request.resource.data.inquiryMessageId)
           ).data.quantity

        && get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.farmerId
           == request.auth.uid

        && get(
          /databases/$(database)/documents/messages/$(request.resource.data.inquiryMessageId)
        ).data.productId
           == request.resource.data.productId

        && get(
          /databases/$(database)/documents/messages/$(request.resource.data.inquiryMessageId)
        ).data.conversationId
           == request.resource.data.conversationId

        && get(
          /databases/$(database)/documents/messages/$(request.resource.data.inquiryMessageId)
        ).data.senderId
           == request.resource.data.consumerId;


      /*
       * ==========================================================
       * UPDATE
       * ==========================================================
       */

      allow update: if

        isAdmin()

        ||

        /*
         * Farmer:
         * accepted -> ongoing
         */
        (
          isFarmer()

          && resource.data.farmerId
             == request.auth.uid

          && resource.data.status
             == "accepted"

          && request.resource.data.status
             == "ongoing"

          && request.resource.data.farmerId
             == resource.data.farmerId

          && request.resource.data.consumerId
             == resource.data.consumerId

          && request.resource.data.productId
             == resource.data.productId

          && request.resource.data.conversationId
             == resource.data.conversationId

          && request.resource.data.inquiryMessageId
             == resource.data.inquiryMessageId

          && request.resource.data.quantity
             == resource.data.quantity

          && request.resource.data.ongoingAt
             != null
        )

        ||

        /*
         * Consumer:
         * ongoing -> awaiting_proof
         */
        (
          isConsumer()

          && resource.data.consumerId
             == request.auth.uid

          && resource.data.status
             == "ongoing"

          && request.resource.data.status
             == "awaiting_proof"

          && request.resource.data.consumerId
             == resource.data.consumerId

          && request.resource.data.farmerId
             == resource.data.farmerId

          && request.resource.data.productId
             == resource.data.productId

          && request.resource.data.conversationId
             == resource.data.conversationId

          && request.resource.data.inquiryMessageId
             == resource.data.inquiryMessageId

          && request.resource.data.quantity
             == resource.data.quantity

          && request.resource.data.completionRequestedAt
             != null

          && request.resource.data.completionRequestedBy
             == request.auth.uid
        )

        ||

        /*
         * Consumer:
         * awaiting_proof -> proof_submitted
         */
        (
          isConsumer()

          && resource.data.consumerId
             == request.auth.uid

          && resource.data.status
             == "awaiting_proof"

          && request.resource.data.status
             == "proof_submitted"

          && request.resource.data.consumerId
             == resource.data.consumerId

          && request.resource.data.farmerId
             == resource.data.farmerId

          && request.resource.data.productId
             == resource.data.productId

          && request.resource.data.conversationId
             == resource.data.conversationId

          && request.resource.data.inquiryMessageId
             == resource.data.inquiryMessageId

          && request.resource.data.quantity
             == resource.data.quantity

          && request.resource.data.proof
             != null

          && request.resource.data.proof.url
             is string

          && request.resource.data.proof.url
             != ""

          && request.resource.data.proof.uploadedBy
             == request.auth.uid

          && request.resource.data.proof.uploadedAt
             != null

          && (
            !request.resource.data.proof.keys()
              .hasAny(["publicId"])

            ||

            request.resource.data.proof.publicId
              is string
          )

          && request.resource.data.proofSubmittedAt
             != null
        )

        ||

        /*
         * Farmer:
         * proof_submitted -> completed
         */
        (
          isFarmer()

          && resource.data.farmerId
             == request.auth.uid

          && resource.data.status
             == "proof_submitted"

          && request.resource.data.status
             == "completed"

          && request.resource.data.consumerId
             == resource.data.consumerId

          && request.resource.data.farmerId
             == resource.data.farmerId

          && request.resource.data.productId
             == resource.data.productId

          && request.resource.data.conversationId
             == resource.data.conversationId

          && request.resource.data.inquiryMessageId
             == resource.data.inquiryMessageId

          && request.resource.data.quantity
             == resource.data.quantity

          && request.resource.data.proof
             == resource.data.proof

          && request.resource.data.proofSubmittedAt
             == resource.data.proofSubmittedAt

          && request.resource.data.completedBy
             == request.auth.uid

          && request.resource.data.completedAt
             != null
        )

        ||

        /*
         * Farmer:
         * proof_submitted -> awaiting_proof
         */
        (
          isFarmer()

          && resource.data.farmerId
             == request.auth.uid

          && resource.data.status
             == "proof_submitted"

          && request.resource.data.status
             == "awaiting_proof"

          && request.resource.data.consumerId
             == resource.data.consumerId

          && request.resource.data.farmerId
             == resource.data.farmerId

          && request.resource.data.productId
             == resource.data.productId

          && request.resource.data.conversationId
             == resource.data.conversationId

          && request.resource.data.inquiryMessageId
             == resource.data.inquiryMessageId

          && request.resource.data.quantity
             == resource.data.quantity

          && request.resource.data.proofRejectedAt
             != null

          && request.resource.data.proofRejectedBy
             == request.auth.uid
        )

        ||

        /*
         * Cancellation:
         * accepted / ongoing -> cancelled
         */
        (
          isActive()

          && (
            (
              isConsumer()

              && resource.data.consumerId
                 == request.auth.uid
            )

            ||

            (
              isFarmer()

              && resource.data.farmerId
                 == request.auth.uid
            )
          )

          && (
            resource.data.status
               == "accepted"

            ||

            resource.data.status
               == "ongoing"
          )

          && request.resource.data.status
             == "cancelled"

          && request.resource.data.consumerId
             == resource.data.consumerId

          && request.resource.data.farmerId
             == resource.data.farmerId

          && request.resource.data.productId
             == resource.data.productId

          && request.resource.data.conversationId
             == resource.data.conversationId

          && request.resource.data.inquiryMessageId
             == resource.data.inquiryMessageId

          && request.resource.data.quantity
             == resource.data.quantity

          && request.resource.data.cancelledAt
             != null

          && request.resource.data.cancelledBy
             == request.auth.uid
        )

        ||

        /*
         * Consumer marks completed transaction as reviewed.
         */
        (
          isConsumer()

          && resource.data.consumerId
             == request.auth.uid

          && resource.data.status
             == "completed"

          && request.resource.data.reviewed
             == true

          && request.resource.data.consumerId
             == resource.data.consumerId

          && request.resource.data.farmerId
             == resource.data.farmerId

          && request.resource.data.productId
             == resource.data.productId

          && request.resource.data.conversationId
             == resource.data.conversationId

          && request.resource.data.inquiryMessageId
             == resource.data.inquiryMessageId

          && request.resource.data.quantity
             == resource.data.quantity

          && request.resource.data.status
             == resource.data.status

          && request.resource.data.farmerReviewId
             == inquiryId

          && request.resource.data.productReviewId
             == inquiryId

          && request.resource.data.reviewedAt
             != null
        );


      allow delete: if false;
    }


    /*
     * ============================================================
     * NOTIFICATIONS
     * ============================================================
     */

match /notifications/{notificationId} {

  function isSignedIn() {
    return request.auth != null;
  }

  function isValidType(type) {
    return type in [
      "message",
      "inquiry",
      "system",
      "review",
      "transaction",
      "verification",
      "product"
    ];
  }

  // ============================================================
  // CREATE
  //
  // Notification creation is handled exclusively by the backend
  // using the Firebase Admin SDK (bypasses Firestore rules).
  // Clients must not create notifications directly.
  // ============================================================

  allow create: if false;


  // ============================================================
  // READ
  // ============================================================

  allow read: if isSignedIn()
    && resource.data.recipientId == request.auth.uid;


  // ============================================================
  // UPDATE
  // ============================================================

  allow update: if isSignedIn()
    && resource.data.recipientId == request.auth.uid
    && request.resource.data.recipientId == resource.data.recipientId
    && resource.data.read == false
    && request.resource.data.read == true;


  // ============================================================
  // DELETE
  // ============================================================

  allow delete: if isSignedIn()
    && resource.data.recipientId == request.auth.uid;
}


    /*
     * ============================================================
     * REPORTS
     * ============================================================
     */

    match /reports/{reportId} {

      allow read: if

        isAdmin()

        ||
        (
          isActive()

          && resource.data.reporterId
             == request.auth.uid
        );


      allow create: if

        isActive()

        && request.resource.data.reporterId
           == request.auth.uid

        && request.resource.data.reportedUserId
           is string

        && request.resource.data.reason
           is string

        && request.resource.data.status
           == "pending"

        && request.resource.data.createdAt
           != null;


      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    /*
     * ============================================================
     * GROUPS
     *
     * Collections: groups, group-memberships, group-managers
     *
     * - Any authenticated user can read active groups
     * - Admins can create, update, delete groups
     * - Farmers can apply to join a group
     * - Users cannot approve their own application
     * - Users cannot assign themselves as managers
     *
     * Note: group-managers and group-memberships use compound document
     * IDs ({groupId}_{userId}). Firestore rules cannot use get() with
     * dynamic compound paths in helper functions, so manager permission
     * checks are inlined in the match rules below.
     * ============================================================
     */

    match /groups/{groupId} {
      allow read: if isSignedIn();
      // Group writes must run through permission-checked backend handlers.
      allow create, update, delete: if false;
      match /memberships/{memberId} { allow read, write: if false; }
      match /applications/{appId} { allow read, write: if false; }
    }

    // Membership and application states are backend-authoritative.
    // Other users can see approved affiliations, not private applications.
    match /group-memberships/{membershipId} {
      allow get, list: if isAdmin()
        || (isActive() && resource.data.userId == request.auth.uid)
        || (isActive() && resource.data.status == "approved");
      allow create, update, delete: if false;
    }

    match /group_memberships/{membershipId} {
      allow read, write: if false;
    }

    match /group-managers/{managerId} {
      allow read: if isSignedIn()
        && (
          isAdmin()
          || request.auth.uid == resource.data.userId
        );

      // Manager assignment must atomically create group membership + slot.
      allow create, update, delete: if false;
    }
  }
}
